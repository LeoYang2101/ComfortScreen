<Page x:Class="ComfortScreen.Views.Pages.DisplayPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="显示器">
    <ScrollViewer Padding="{StaticResource PagePadding}"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="多显示器调节" />

            <ui:Card>
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock FontSize="18" FontWeight="SemiBold" Text="调整目标" />
                            <ComboBox Width="360"
                                      ItemsSource="{Binding MonitorTargets}"
                                      SelectedItem="{Binding SelectedMonitorTarget}" />
                            <TextBlock Margin="0,10,0,0"
                                       Style="{StaticResource CaptionTextStyle}"
                                       Text="选择“全部显示器”时，下面的滑条会同步应用到所有屏幕。" />
                        </StackPanel>

                        <ui:Button Grid.Column="1"
                                   Margin="16,30,0,0"
                                   Command="{Binding RefreshMonitorsCommand}"
                                   Content="刷新显示器"
                                   Icon="{ui:SymbolIcon ArrowSync20}" />
                    </Grid>
                </StackPanel>
            </ui:Card>

            <ui:Card>
                <StackPanel>
                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="滤镜与亮度" />

                    <TextBlock Margin="0,18,0,0" Text="{Binding TemperatureLabel}" />
                    <Slider Minimum="1000"
                            Maximum="6500"
                            TickFrequency="100"
                            IsSnapToTickEnabled="True"
                            Value="{Binding TemperatureKelvin}" />

                    <TextBlock Margin="0,18,0,0" Text="{Binding BrightnessLabel}" />
                    <Slider Minimum="10"
                            Maximum="100"
                            TickFrequency="1"
                            Value="{Binding BrightnessPercent}" />

                    <TextBlock Margin="0,18,0,0" Text="{Binding OpacityLabel}" />
                    <Slider Minimum="0"
                            Maximum="80"
                            TickFrequency="1"
                            Value="{Binding FilterOpacityPercent}" />
                </StackPanel>
            </ui:Card>
        </StackPanel>
    </ScrollViewer>
</Page>
