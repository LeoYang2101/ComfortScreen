<Page x:Class="ComfortScreen.Views.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="设置">
    <ScrollViewer Padding="{StaticResource PagePadding}"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="设置与个性化" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <ui:Card Margin="0,0,12,16">
                    <StackPanel>
                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="全局快捷键" />
                        <CheckBox Content="启用全局快捷键"
                                  IsChecked="{Binding HotkeyEnabled}" />

                        <TextBlock Margin="0,18,0,0" Style="{StaticResource CaptionTextStyle}" Text="组合键" />
                        <ComboBox Width="220"
                                  ItemsSource="{Binding HotkeyModifierOptions}"
                                  SelectedItem="{Binding SelectedHotkeyModifier}"
                                  DisplayMemberPath="DisplayName" />

                        <TextBlock Margin="0,18,0,0" Style="{StaticResource CaptionTextStyle}" Text="按键" />
                        <ComboBox Width="160"
                                  ItemsSource="{Binding HotkeyKeys}"
                                  SelectedItem="{Binding SelectedHotkeyKey}" />

                        <TextBlock Margin="0,14,0,0"
                                   Style="{StaticResource CaptionTextStyle}"
                                   Text="{Binding HotkeyStatusText}" />
                    </StackPanel>
                </ui:Card>

                <ui:Card Grid.Column="1">
                    <StackPanel>
                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="外观主题" />
                        <TextBlock Margin="0,8,0,0"
                                   Style="{StaticResource CaptionTextStyle}"
                                   Text="在浅色和暗色之间切换，界面文字、表面和强调色会同步调整" />
                        <ComboBox Width="220"
                                  ItemsSource="{Binding ThemeOptions}"
                                  SelectedItem="{Binding SelectedTheme}"
                                  DisplayMemberPath="DisplayName" />

                        <TextBlock Margin="0,22,0,0" FontSize="18" FontWeight="SemiBold" Text="启动行为" />
                        <CheckBox Content="开机登录时自动启动（静默到托盘）"
                                  IsChecked="{Binding StartWithWindows}" />
                        <TextBlock Margin="0,10,0,0"
                                   Style="{StaticResource CaptionTextStyle}"
                                   Text="{Binding StartupStatusText}"
                                   TextWrapping="Wrap" />
                        <TextBlock Margin="0,8,0,0"
                                   Style="{StaticResource CaptionTextStyle}"
                                   Text="仅对当前 Windows 用户生效，登录后后台启动并驻留托盘，不主动弹出主窗口" />
                    </StackPanel>
                </ui:Card>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
