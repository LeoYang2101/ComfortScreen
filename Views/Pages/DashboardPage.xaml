<Page x:Class="ComfortScreen.Views.Pages.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="概览">
    <ScrollViewer Padding="{StaticResource PagePadding}"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="今日护眼概览" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <ui:Card Margin="0,0,12,16">
                    <StackPanel>
                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="当前屏幕状态" />
                        <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" Text="{Binding ModeSummary}" />
                        <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                            <ui:Button Command="{Binding ToggleFilterCommand}"
                                       Content="{Binding FilterToggleText}"
                                       Appearance="Primary"
                                       Margin="0,0,12,0" />
                            <ui:Button Command="{Binding ActivateNightModeCommand}"
                                       Content="快速夜间模式"
                                       Icon="{ui:SymbolIcon WeatherMoon20}" />
                        </StackPanel>
                    </StackPanel>
                </ui:Card>

                <ui:Card Grid.Column="1">
                    <StackPanel>
                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="工作 / 休息状态" />
                        <TextBlock Margin="0,12,0,0" Text="{Binding CountdownStatusText}" />
                        <ProgressBar Value="{Binding WorkRestProgress}" Maximum="100" />
                    </StackPanel>
                </ui:Card>
            </Grid>

            <ui:Card>
                <StackPanel>
                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="快捷预设" />
                    <TextBlock Margin="0,8,0,0"
                               Style="{StaticResource CaptionTextStyle}"
                               Text="根据当前工作状态快速切换更合适的护眼模式" />
                    <WrapPanel Margin="0,18,0,0">
                        <ui:Button Command="{Binding ActivateDayModeCommand}"
                                   Content="日间模式"
                                   Appearance="Secondary"
                                   Margin="0,0,12,12" />
                        <ui:Button Command="{Binding ActivateNightModeCommand}"
                                   Content="夜间模式"
                                   Appearance="Secondary"
                                   Margin="0,0,12,12" />
                        <ui:Button Command="{Binding ActivateReadingModeCommand}"
                                   Content="阅读模式"
                                   Appearance="Secondary"
                                   Margin="0,0,12,12" />
                    </WrapPanel>
                </StackPanel>
            </ui:Card>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <ui:Card Margin="0,0,12,16">
                    <StackPanel>
                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="显示器" />
                        <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" Text="{Binding DisplaySummary}" />
                    </StackPanel>
                </ui:Card>

                <ui:Card Grid.Column="1" Margin="0,0,12,16">
                    <StackPanel>
                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="20-20-20" />
                        <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" Text="{Binding ReminderSummary}" />
                    </StackPanel>
                </ui:Card>

                <ui:Card Grid.Column="2">
                    <StackPanel>
                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="自动切换" />
                        <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" Text="{Binding AutomationSummary}" />
                    </StackPanel>
                </ui:Card>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
