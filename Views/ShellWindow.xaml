<ui:FluentWindow x:Class="ComfortScreen.Views.ShellWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:pages="clr-namespace:ComfortScreen.Views.Pages"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 mc:Ignorable="d"
                 Title="ComfortScreen"
                 Width="1220"
                 Height="860"
                 MinWidth="980"
                 MinHeight="760"
                 WindowStartupLocation="CenterScreen">
    <Grid Background="{DynamicResource ComfortScreenShellBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="14,12,14,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Background="{DynamicResource ComfortScreenHeroBrush}"
                    CornerRadius="18"
                    Padding="6">
                <ui:TitleBar Title="ComfortScreen"
                             Icon="{ui:SymbolIcon EyeTracking20}" />
            </Border>

            <Border Grid.Row="1"
                    Margin="0,14,0,0"
                    Background="{DynamicResource ComfortScreenSurfaceBrush}"
                    BorderBrush="{DynamicResource ComfortScreenSurfaceBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="20"
                    Padding="24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock FontSize="28" FontWeight="SemiBold" Text="让屏幕更适合长时间专注" />
                        <TextBlock Margin="0,6,0,0"
                                   Style="{StaticResource CaptionTextStyle}"
                                   Text="{Binding CurrentModeText}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <ui:Button Command="{Binding ToggleFilterCommand}"
                                   Content="{Binding FilterToggleText}"
                                   Appearance="Primary"
                                   Icon="{ui:SymbolIcon Lightbulb20}"
                                   Margin="0,0,12,0" />
                        <ui:Button Command="{Binding MinimizeToTrayCommand}"
                                   Content="最小化到托盘"
                                   Icon="{ui:SymbolIcon ArrowMinimize20}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="1"
                Margin="14,12,14,14"
                Background="{DynamicResource ComfortScreenNavigationHostBrush}"
                BorderBrush="{DynamicResource ComfortScreenNavigationHostBorderBrush}"
                BorderThickness="1"
                CornerRadius="24">
            <ui:NavigationView x:Name="RootNavigation"
                               PaneDisplayMode="Left"
                               IsBackButtonVisible="Collapsed"
                               IsPaneToggleVisible="True"
                               Background="{DynamicResource ComfortScreenNavigationHostBrush}"
                               Padding="10">
                <ui:NavigationView.MenuItems>
                    <ui:NavigationViewItem Content="概览"
                                           Icon="{ui:SymbolIcon Home20}"
                                           TargetPageType="{x:Type pages:DashboardPage}" />
                    <ui:NavigationViewItem Content="护眼"
                                           Icon="{ui:SymbolIcon EyeTracking20}"
                                           TargetPageType="{x:Type pages:EyeCarePage}" />
                    <ui:NavigationViewItem Content="显示器"
                                           Icon="{ui:SymbolIcon Desktop20}"
                                           TargetPageType="{x:Type pages:DisplayPage}" />
                    <ui:NavigationViewItem Content="提醒"
                                           Icon="{ui:SymbolIcon Timer20}"
                                           TargetPageType="{x:Type pages:ReminderPage}" />
                </ui:NavigationView.MenuItems>

                <ui:NavigationView.FooterMenuItems>
                    <ui:NavigationViewItem Content="设置"
                                           Icon="{ui:SymbolIcon Settings20}"
                                           TargetPageType="{x:Type pages:SettingsPage}" />
                </ui:NavigationView.FooterMenuItems>
            </ui:NavigationView>
        </Border>
    </Grid>
</ui:FluentWindow>
